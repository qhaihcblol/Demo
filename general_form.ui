            <item>
             <widget class="QComboBox" name="Power_Button_Behavior_CbB">
              <property name="styleSheet">
               <string notr="true">QComboBox {
    background-color: #FFFFFF; /* Màu nền trắng */
    color: #333333;           /* Màu chữ đậm */
    border: 1px solid #CCCCCC; /* Viền màu xám nhạt */
    border-radius: 5px;       /* Bo góc nhẹ */
    padding: 5px 10px;        /* Khoảng cách bên trong */
}

QComboBox:hover {
    border: 1px solid #AAAAAA; /* Viền đậm hơn khi rê chuột */
}

QComboBox::drop-down {
    border: none;             /* Loại bỏ viền dropdown */
    background-color: #FFFFFF; /* Nền trắng */
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left: 1px solid #CCCCCC; /* Viền trái dropdown */
}

QComboBox::down-arrow {
    image: url(:/image/Resource/down-arrow.svg);
    width: 20px;
    height: 20px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF; /* Nền danh sách */
    border: 1px solid #CCCCCC; /* Viền danh sách */
    selection-background-color: #F0F0F0; /* Nền khi chọn */
    selection-color: #333333;  /* Màu chữ khi chọn */
    color: #333333;            /* Màu chữ mặc định */
    padding: 5px;
    border-radius: 5px;
}
QComboBox:disabled {
    background-color: #F0F0F0; /* Nền xám nhạt */
    color: #A0A0A0;           /* Màu chữ xám nhạt */
    border: 1px solid #E0E0E0; /* Viền xám nhạt */
}

QComboBox::drop-down:disabled {
    background-color: #F0F0F0; /* Nền xám nhạt cho dropdown */
    border-left: 1px solid #E0E0E0; /* Viền trái xám nhạt */
}

QComboBox::down-arrow:disabled {
    width: 20px;
    height: 20px;
}
</string>
