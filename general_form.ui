           <property name="styleSheet">
            <string notr="true">QCheckBox {
    spacing: 10px;
    font-size: 16px;
    color: #333;
    background-color: rgb(246, 245, 244); /* Nền mặc định */
    border: 2px solid rgb(222, 221, 218); /* Viền mặc định */
    border-radius: 10px; /* Bo tròn góc */
    padding: 10px;
}

QCheckBox:checked {
    background-color: rgb(200, 255, 200); /* Nền xanh lá nhạt khi checked */
    border: 2px solid rgb(0, 150, 0); /* Viền xanh lá đậm khi checked */
    color: #333; /* Giữ màu chữ khi checked */
}
</string>
