         <string notr="true">QPushButton {
    background-color: #007BFF; /* Nền xanh */
    color: #FFFFFF;            /* Chữ trắng */
    border: 1px solid #0056b3; /* Viền xanh đậm */
    border-radius: 5px;        /* Bo góc nhẹ */
    padding: 8px 15px;         /* Khoảng cách bên trong */
    font-size: 14px;           /* Cỡ chữ */
    font-weight: bold;         /* Chữ đậm */
}

QPushButton:hover {
    background-color: #0056b3; /* Nền đậm hơn khi rê chuột */
    border: 1px solid #004085; /* Viền đậm hơn khi rê chuột */
}

QPushButton:pressed {
    background-color: #004085; /* Nền tối hơn khi nhấn */
    border: 1px solid #003366; /* Viền đậm hơn khi nhấn */
}</string>
